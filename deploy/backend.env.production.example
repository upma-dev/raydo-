# Copy to ~/appzeto/Backend/.env on the VPS and fill the blanks.
PORT=5000
SOCKET_PORT=5001
HOST=127.0.0.1
NODE_ENV=production

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

FRONTEND_URL=https://appzeto.com
SOCKET_CORS_ORIGIN=https://appzeto.com

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_ENABLED=true

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=3500
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30

UPLOAD_PATH=/var/www/uploads/

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="AppZeto <noreply@appzeto.com>"

GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

USE_DEFAULT_OTP=false
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
OTP_EXPIRY=5m
